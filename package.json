{
  "name": "revguard-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "RevGuard — AI Revenue Recovery Agent platform for Track 03",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ai": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --app-dir ai-service",
    "db:seed": "npm --prefix backend run db:seed",
    "db:push": "npm --prefix backend run db:push",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "build": "npm --prefix backend run build && npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
