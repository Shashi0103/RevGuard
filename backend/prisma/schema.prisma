datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Merchant {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customers    Customer[]
  transactions Transaction[]
}

model Customer {
  id           String        @id @default(uuid())
  merchantId   String
  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id                 String           @id @default(uuid())
  merchantId         String
  merchant           Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount             Float
  currency           String           @default("INR")
  paymentMethod      String           // e.g. UPI, Card, NetBanking, Mandate
  status             String           // e.g. FAILED, RECOVERED, PENDING_REVIEW, RECOVERY_FAILED, EXPIRED
  failureReason      String           // e.g. gateway_timeout, insufficient_funds, bank_declined, upi_failure, card_declined, checkout_abandoned, subscription_failed, mandate_failed, invoice_overdue, suspicious_transaction
  retryCount         Int              @default(0)
  checkoutStatus     String           // e.g. ABANDONED, COMPLETED, IN_PROGRESS
  subscriptionStatus String           // e.g. ACTIVE, PAST_DUE, PAUSED, CANCELED
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  agentDecisions     AgentDecision[]
  recoveryActions    RecoveryAction[]
  auditLogs          AuditLog[]
}

model AgentDecision {
  id                  String      @id @default(uuid())
  transactionId       String
  transaction         Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  diagnosis           String      // e.g. temporary_payment_failure, customer_abandonment, card_expired, mandate_revoked, high_risk_decline
  confidence          Float
  recoveryProbability Float
  recommendedAction   String      // e.g. retry_payment, generate_payment_link, send_reminder, alternate_method, escalate, stop
  riskLevel           String      // e.g. low, medium, high
  reason              String
  guardrailStatus     String      // e.g. PASSED, BLOCKED, ESCALATED
  createdAt           DateTime    @default(now())
}

model RecoveryAction {
  id             String      @id @default(uuid())
  transactionId  String
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actionType     String      // e.g. retry_payment, generate_payment_link, send_reminder, alternate_method, escalate
  status         String      // e.g. PENDING, EXECUTED, REJECTED, SUCCESS, FAILED
  amountRecovered Float      @default(0.0)
  executedBy     String      // e.g. RevGuard Agent, Merchant Operator
  executedAt     DateTime?
  result         String
  createdAt      DateTime    @default(now())
}

model AuditLog {
  id            String      @id @default(uuid())
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  event         String
  decision      String
  reason        String
  actor         String
  result        String
  metadata      String      // JSON string representation of extra metadata
  createdAt     DateTime    @default(now())
}
