# Neon PostgreSQL Connection String (or local fallback SQLite / PostgreSQL)
# Example Neon Connection String: postgresql://neondb_owner:password@ep-cool-shield-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="file:./dev.db"

# Optional Razorpay API credentials for Test Mode integration
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional LLM API Key (OpenAI / Anthropic / Gemini API key for dynamic reasoning fallback)
LLM_API_KEY=""

# Service Endpoints
AI_SERVICE_URL="http://localhost:8000"
BACKEND_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:5173"

# Application Mode
DEMO_MODE="true"
PORT="5000"
NODE_ENV="development"
